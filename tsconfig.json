{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "ESNext",
        // Was `Node` (= node10), which TS >= 5.9 reports as a deprecation
        // ERROR and which kills the .d.ts emit. `ignoreDeprecations` cannot fix
        // it portably: 5.9 rejects "6.0" (TS5103) while 6.x demands it, so the
        // value that unbreaks one toolchain breaks the other — which is why a
        // cold-cache `turbo build` failed on the amisferme box while infra
        // replayed a cache hit. `Bundler` carries no deprecation on either, and
        // is the right mode for a tsup/esbuild-bundled package: only the .d.ts
        // emit uses tsc resolution, the ESM output never did.
        "moduleResolution": "Bundler",
        // tsup FORCES `baseUrl: compilerOptions.baseUrl || "."` into the dts
        // build (see tsup/dist/rollup.js), so that deprecation cannot be avoided
        // from here — only silenced. The accepted value is version-locked: TS 6
        // takes "6.0" and rejects "5.0", 5.9 the reverse. The typescript
        // devDependency is pinned to the same 6.x line the monorepo root uses,
        // so this value is always the correct one.
        "ignoreDeprecations": "6.0",
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "noEmit": false,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "**/*.test.ts",
        "**/*.spec.ts"
    ]
}
